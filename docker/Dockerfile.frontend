# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN --mount=type=secret,id=ca_bundle \
    if [ -s /run/secrets/ca_bundle ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/ca_bundle; fi; npm ci
COPY frontend .
ARG API_INTERNAL_URL=http://api:3000
ARG ANOMALY_INTERNAL_URL=http://anomaly:5000
ENV API_INTERNAL_URL=$API_INTERNAL_URL ANOMALY_INTERNAL_URL=$ANOMALY_INTERNAL_URL NEXT_TELEMETRY_DISABLED=1
RUN npm run build
FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static .next/static
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3001 NEXT_TELEMETRY_DISABLED=1
USER node
EXPOSE 3001
CMD ["node","server.js"]
