# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm
WORKDIR /app
COPY anomaly/requirements.txt ./
RUN --mount=type=secret,id=ca_bundle \
    if [ -s /run/secrets/ca_bundle ]; then export PIP_CERT=/run/secrets/ca_bundle; fi; pip install --no-cache-dir -r requirements.txt
COPY --chown=1000:1000 anomaly/src src
RUN mkdir -p /data && chown 1000:1000 /data
ENV DB_PATH=/data/logs.db MODEL_PATH=/data/model.pkl OPENBLAS_NUM_THREADS=2 OMP_NUM_THREADS=2
USER 1000:1000
CMD ["python","-m","uvicorn","src.main:app","--host","0.0.0.0","--port","5000"]
